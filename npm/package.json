  "version": "0.0.0",
  "description": "Linter and language server for Concourse CI pipelines: finds errors, security issues and bad practice before fly set-pipeline.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mfast99/concourse-lint.git",
    "directory": "npm"
  },
  "homepage": "https://github.com/mfast99/concourse-lint#readme",
  "bugs": "https://github.com/mfast99/concourse-lint/issues",
  "keywords": [
    "concourse",
