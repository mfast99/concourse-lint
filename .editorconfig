root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[{Makefile,*.mk}]
indent_style = tab

[*.{yml,yaml,md,json}]
indent_style = space
indent_size = 2

# Spec cases: whitespace can be part of the test (tabs, trailing spaces).
[spec/**]
trim_trailing_whitespace = false
indent_style = unset
indent_size = unset
